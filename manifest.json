{
  "id": "elec-session-enhance",
  "name": "会话增强 (Session Enhance)",
  "version": "0.14.0",
  "description": "DSH session-enhance toolkit: open-question deliberation and cross-repo task running.",
  "kind": "dynamic-cordis-plugin",
  "platforms": {
    "host": "src/index.ts",
    "client": "src/client/index.tsx"
  },
  "host": {
    "handlers": [
      "session.start",
      "session.state",
      "session.stop"
    ],
    "services": []
  },
  "client": {
    "slots": [
      "shell.overlay",
      "conversation.input.right",
      "settings.section"
    ],
    "services": [
      "slots",
      "layout"
    ]
  },
  "license": "MIT"
}
